PORT=3000
COOKIE_SECRET=your-secret-key
PUBLIC_BASE_URL=http://localhost:3000

# Database (MySQL)
MYSQL_URL=
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=goddygraphix

# Image uploads
# If ImageKit is configured, uploads go to ImageKit. Otherwise files are saved locally under /uploads.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Legacy Cloudinary values currently are not used by server.js
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Notifications (Optional)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_TO=recipient@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Python Email Automation (EmailJS)
# Set to 'true' to enable EmailJS emails via Python script
PYTHON_EMAIL_AUTOMATION=true
PYTHON_EMAIL_URL=http://localhost:5000/send-emails

# EmailJS Credentials — Get these from https://dashboard.emailjs.com/admin
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_BUSINESS_TEMPLATE_ID=your_business_template_id
EMAILJS_CUSTOMER_TEMPLATE_ID=your_customer_template_id

# Businessman Email Address
BUSINESSMAN_EMAIL=laryeamel06@gmail.com
